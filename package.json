{
  "name": "smartparking",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "audit": "node dist/audit/main.js",
    "outbox": "node dist/audit/worker.js",
    "db:setup": "tsx src/scripts/setup.ts",
    "seed": "tsx src/scripts/seed.ts",
    "results:export": "node scripts/export-results.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:integration": "npm run build && node --test tests/integration.cjs",
    "test:outbox": "npm run build && node --test tests/outbox.integration.cjs",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 delete ecosystem.config.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "pm2": "^7.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
