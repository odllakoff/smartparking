@startuml
title SmartParking - Componentes e interfaces
skinparam componentStyle uml2
skinparam linetype ortho
left to right direction
component "UI mínima\nHTML / JS" as UI
node "PM2 cluster - N workers" {
  component "API HTTP\nExpress + Zod\nBearer / rol ADMIN" as API
  component "Identidad\nlogin / emisión JWT\nvalidación firma y vigencia" as Auth
  component "Negocio\nClientes / Vehículos / Reservas\npertenencia y reglas" as Biz
  component "PgBusinessRepository" as BR
  component "PgIdentityRepository" as IR
  component "PgOutboxPublisher\nconexión de la transacción" as OP
  interface "REST / DTOs" as REST
  interface "IdentityService\nlogin / validate" as AUTH
  interface "BusinessService\nCRUD / consultas" as USE
  interface "BusinessRepository" as IB
  interface "IdentityRepository" as II
  interface "EventPublisher" as IE
  API - REST
  UI ..> REST : requiere
  Auth - AUTH
  API ..> AUTH : requiere
  Biz - USE
  API ..> USE : requiere
  BR - IB
  Biz ..> IB : requiere
  IR - II
  Auth ..> II : requiere
  Biz ..> II : existe identidad
  OP - IE
  Biz ..> IE : dentro de transaction()
}
database "PostgreSQL negocio\npublic: Clientes / Vehículos / Reservas\nintegration.outbox: tabla técnica" as DB
database "PostgreSQL identidad\nUsuarios / hashes / roles\nservidor y volumen separados" as IDB
node "Publicador independiente\nPM2 fork - 1 instancia" {
  component "OutboxDispatcher\npolling / reintentos / backoff" as DP
  component "HttpEventPublisher" as EP
  interface "EventPublisher\ntransporte" as TRANSPORT
  EP - TRANSPORT
  DP ..> TRANSPORT : requiere
}
node "Proceso independiente\nPM2 fork - 1 instancia" {
  component "Registro de eventos\nvalida / deduplica / conserva" as Log
  interface "POST /events\nEventoAuditoriaDTO" as EVENTS
  Log - EVENTS
}
database "SQLite auditoría\neventId único / WAL" as LDB
EP ..> EVENTS : HTTP + secreto / 204
BR --> DB : SQL / pool
OP --> DB : INSERT evento / mismo commit
IR --> IDB : SQL / pool
DP --> DB : SKIP LOCKED / delivered_at
Log --> LDB : persistir antes de confirmar
note bottom of DP
  Negocio + evento: commit atómico.
  HTTP: timeout 1,5 s por intento.
  Reintentos durables con mismo eventId.
  Al menos una vez; receptor idempotente.
end note
legend bottom
  Línea a interfaz: provista. Flecha discontinua: requerida.
  Bases independientes: identidad no comparte storage con negocio.
endlegend
@enduml
